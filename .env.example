# Steel Billet Inspection - Environment Configuration
# Copy this file to .env and fill in your values

# --- LLM Configuration (Optional - for chatbot) ---
# Leave blank for rule-based chatbot fallback
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Application Settings ---
APP_HOST=0.0.0.0
APP_PORT=8501
DEBUG_MODE=false

# --- Database ---
DATABASE_PATH=data/inspection.db

# --- Processing ---
MAX_UPLOAD_SIZE_MB=500
DEFAULT_FRAME_SKIP=3
DEFAULT_CONFIDENCE_THRESHOLD=0.5
GPU_ENABLED=false
